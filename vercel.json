{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    },
    {
      "source": "/search-index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ],
  "redirects": [
    { "source": "/categories/", "destination": "/components/", "permanent": true },
    { "source": "/categories/crystal-oscillator/", "destination": "/components/passive-components/oscillators-resonators/", "permanent": true },
    { "source": "/categories/electrolytic-capacitor/", "destination": "/components/passive-components/capacitors/", "permanent": true },
    { "source": "/categories/mems-sensor/", "destination": "/components/sensors/sensors/", "permanent": true },
