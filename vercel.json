{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
      "source": "/search-index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/categories/",
      "destination": "/components/",
      "permanent": true
    },
    {
      "source": "/categories/microcontroller/",
      "destination": "/components/integrated-circuits/microcontrollers/",
      "permanent": true
    },
    {
      "source": "/categories/crystal-oscillator/",
      "destination": "/components/passive-components/oscillators/",
      "permanent": true
    },
    {
      "source": "/categories/electrolytic-capacitor/",
      "destination": "/components/passive-components/aluminum-electrolytic-capacitors/",
      "permanent": true
    },
    {
      "source": "/categories/pin-header/",
      "destination": "/components/connectors-electromechanical/headers-male-pins/",
      "permanent": true
    },
    {
      "source": "/sourcing-service(/?.*)",
      "destination": "/sourcing/",
      "permanent": true
    },
    {
      "source": "/components/connectors/",
      "destination": "/components/connectors-electromechanical/",
      "permanent": true
    },
    {
      "source": "/components/modules/",
      "destination": "/components/modules-communication/",
      "permanent": true
    },
    {
      "source": "/components/semiconductor-components/",
      "destination": "/components/semiconductors-discrete/",
      "permanent": true
    },
    {
      "source": "/components/passive-components/crystal-oscillator/",
      "destination": "/components/passive-components/oscillators/",
      "permanent": true
    },
    {
      "source": "/components/passive-components/inductor/",
      "destination": "/components/passive-components/fixed-inductors/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/analog-ic",
      "destination": "/components/integrated-circuits/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/analog-ic/",
      "destination": "/components/integrated-circuits/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/i-o-expanders",
      "destination": "/components/integrated-circuits/i-o-expanders/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/i-o-expanders/",
      "destination": "/components/integrated-circuits/i-o-expanders/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/memory",
      "destination": "/components/memory/memory/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/memory/",
      "destination": "/components/memory/memory/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/memory-ic",
      "destination": "/components/memory/memory/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/memory-ic/",
      "destination": "/components/memory/memory/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/microcontroller",
      "destination": "/components/integrated-circuits/microcontrollers/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/microcontroller/",
      "destination": "/components/integrated-circuits/microcontrollers/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/microcontroller/page/2",
      "destination": "/components/integrated-circuits/microcontrollers/",
      "permanent": true
    },
    {
      "source": "/components/integrated-circuits/microcontroller/page/2/",
      "destination": "/components/integrated-circuits/microcontrollers/",
      "permanent": true
    }
  ]
}
